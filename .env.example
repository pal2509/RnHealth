# Copy to .env and fill in: cp .env.example .env

# MongoDB root user, created the first time the database starts
MONGO_USERNAME=rnadmin
MONGO_PASSWORD=change-me
MONGO_DB_NAME=RnHealthDB
mongoConnString=mongodb://rnmongo:27017/

# Signs login tokens and the private evaluation links: a long random string (openssl rand -hex 32)
secretKey=change-me

# The first admin, created when the API starts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SMTP account that emails people their evaluation links. Optional: left empty, no email is sent.
appEmail=
appEmailPwd=
appEmailSMTP=
appEmailSMTPPort=587
appUrl=http://localhost:50003/
